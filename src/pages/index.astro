---
import ContactSection from "~/components/home/ContactSection.astro";
import HeroIntro from "~/components/home/HeroIntro.astro";
import StudioSection from "~/components/home/StudioSection.astro";
import WorkSection from "~/components/home/WorkSection.astro";
import DesignOverlay from "~/components/ui/layout/DesignOverlay.astro";
import SecretFocusOverlay from "~/components/ui/layout/SecretFocusOverlay.astro";
import Footer from "~/components/ui/layout/Footer.astro";
import Header from "~/components/ui/layout/Header.astro";
import NyaomaruWalker from "~/components/ui/nyaomaru/NyaomaruWalker.astro";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "~/lib/site-metadata";
import Layout from "~/layouts/Layout.astro";
---

<Layout
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
>
  <div class="loading-screen" aria-hidden="true">
    <img src="/assets/animation/necoz_loading.gif" alt="" />
  </div>
  <div class="pixel-page">
    <main id="top">
      <h1 class="sr-only">
        Necoz is a software development studio based in Amsterdam, the
        Netherlands.
      </h1>
      <Header />
      <HeroIntro />
      <WorkSection />
      <StudioSection />
      <ContactSection />
      <NyaomaruWalker />
    </main>
    <Footer />
    <DesignOverlay />
    <SecretFocusOverlay mode="exit" />
  </div>
</Layout>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: var(--bg);
    animation: finish-loading 2s forwards;
  }

  .loading-screen img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: translateY(-2vh);
  }

  @media (--necoz-phone) {
    .loading-screen img {
      object-fit: cover;
      transform: none;
    }
  }

  @keyframes finish-loading {
    99% {
      visibility: visible;
    }
    100% {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen {
      display: none;
    }
  }

  .pixel-page {
    position: relative;
    overflow-x: clip;
  }

  main {
    position: relative;
  }
</style>
