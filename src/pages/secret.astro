---
import SecretFocusOverlay from "~/components/ui/layout/SecretFocusOverlay.astro";
import Header from "~/components/ui/layout/Header.astro";
import Layout from "~/layouts/Layout.astro";
---

<Layout
  title="Secret | Necoz"
  description="Secret Necoz homepage."
  canonicalPath="/secret/"
  noindex
  virtualScroll={false}
  secretFocusEntry
>
  <SecretFocusOverlay mode="enter" />
  <div class="secret-home" data-secret-page>
    <Header homeHref="/" />
    <main>
      <img src="/assets/icons/nyaomaru.svg" alt="" width="120" height="118" />
      <p class="secret-home__eyebrow">Necoz</p>
      <h1>Secret home</h1>
      <p class="secret-home__copy">
        This mock page is what opens after the focus-out.
      </p>
    </main>
  </div>
</Layout>

<style>
  .secret-home {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(255, 244, 214, 0.7), transparent 28rem),
      #e7d7b1;
    color: #2c2924;
  }

  .secret-home main {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  .secret-home__eyebrow {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .secret-home h1 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 500;
    line-height: 0.92;
  }

  .secret-home__copy {
    max-width: 28rem;
    margin: 0;
    color: #5c564c;
    font-size: 1.25rem;
    line-height: 1.6;
  }
</style>
