---
import SecretFocusOverlay from "~/components/ui/layout/SecretFocusOverlay.astro";
import Header from "~/components/ui/layout/Header.astro";
import Layout from "~/layouts/Layout.astro";
---

<Layout
  title="Secret | Necoz"
  description="Secret Necoz homepage."
  canonicalPath="/secret/"
  noindex
  virtualScroll={false}
  secretFocusEntry
>
  <SecretFocusOverlay mode="enter" />
  <div class="secret-home" data-secret-page>
    <Header homeHref="/" />
    <main>
      <div class="secret-home__intro">
        <img src="/assets/icons/nyaomaru.svg" alt="" width="120" height="118" />
        <p class="secret-home__eyebrow">Necoz</p>
        <h1>Secret home</h1>
        <p class="secret-home__copy">
          This mock page is what opens after the focus-out.
        </p>
      </div>
      <div class="secret-room" aria-label="A secret room with cats">
        <svg class="secret-room__background" viewBox="0 0 390 340" aria-hidden="true">
          <path class="secret-room__floor" d="M17 285 L79 187 Q105 181 132 185 Q159 183 184 185 Q205 181 228 186 Q252 184 272 187 L312 188 L385 267 Q328 280 286 291 Q241 300 197 296 Q150 293 109 291 Q64 293 39 290 Z" />
          <g class="secret-room__lines">
            <path d="M17 285 L16 18 Q16 14 20 17 L48 37 Q60 41 78 41 L312 43 Q322 42 328 35 L360 6 Q363 3 361 15 L385 235 Q388 243 380 237 L341 215 L312 188 L309 45" />
            <path d="M78 42 Q75 100 79 187 M312 44 Q315 112 312 188 M208 42 L209 61" />
            <path d="M209 61 C202 61 202 72 207 74 C200 78 205 85 210 85 C219 83 220 76 214 72 C216 66 214 62 209 61 Z" />
            <path d="M35 228 Q32 186 34 153 Q35 129 42 140 Q53 149 52 166 L52 197 Q47 213 38 226 M337 202 Q329 194 335 184 Q337 176 341 173 Q340 158 350 158 Q365 157 369 173 L373 188 M334 185 L377 187 L376 215 L341 202 M340 191 L374 206 M341 202 L351 210" />
          </g>
          <g class="secret-room__labels">
            <text x="25" y="102">Junk</text>
            <text x="325" y="118">Junk</text>
            <path d="M56 112 L37 109 L42 104 L27 115 L44 121 L41 116 L55 118 Z M342 129 L359 126 L355 122 L371 131 L355 139 L357 134 L343 135 Z" />
          </g>
        </svg>
        <img class="secret-room__upper-cat secret-room__upper-cat--left" src="/assets/icons/秘密の部屋-10.png" alt="" />
        <img class="secret-room__upper-cat secret-room__upper-cat--right" src="/assets/icons/秘密の部屋-11.png" alt="" />
        <div class="secret-room__cats">
          <img src="/assets/icons/1_フォトショ_ハイパーキュービック方自動500パーセント.png" alt="" />
          <img src="/assets/icons/2_フォトショップで500パーセントニアレストネイバー.png" alt="" />
          <img src="/assets/icons/3_さらにイラレで360dpiに拡大-11.png" alt="" />
          <img src="/assets/icons/4_さらにイラレで360dpiに拡大-10.png" alt="" />
          <img src="/assets/icons/5_フォトショ_ニアレストネイバー_倍率なし.png" alt="" />
        </div>
      </div>
    </main>
    <div class="secret-home__ground" aria-hidden="true"></div>
  </div>
</Layout>

<style>
  .secret-home {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(255, 244, 214, 0.7), transparent 28rem),
      #e7d7b1;
    color: #2c2924;
  }

  .secret-home main {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  .secret-home__intro {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .secret-room,
  .secret-home__ground {
    display: none;
  }

  .secret-home__eyebrow {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .secret-home h1 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 500;
    line-height: 0.92;
  }

  .secret-home__copy {
    max-width: 28rem;
    margin: 0;
    color: #5c564c;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  @media (--necoz-phone) {
    .secret-home {
      background: #141715;
    }

    .secret-home :global(.header-clouds img) {
      filter: brightness(0) saturate(100%) invert(76%) sepia(42%)
        saturate(686%) hue-rotate(38deg) brightness(98%);
    }

    .secret-home :global(.links > img[src$="necoz_secret-room_necoz_menu.png"]) {
      width: 4rem;
    }

    .secret-home :global(.links > img[src$="necoz_secret-room_necoz_portforio_01.png"]) {
      width: 2.5rem;
    }

    .secret-home main {
      display: flex;
      align-items: center;
      min-height: 28rem;
      padding: 0 0 3rem;
    }

    .secret-home__intro {
      display: none;
    }

    .secret-room {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 390 / 340;
    }

    .secret-room__background {
      display: block;
      width: 100%;
      height: 100%;
    }

    .secret-room__floor {
      fill: #a8a88b;
    }

    .secret-room__lines {
      fill: none;
      stroke: #a8a88b;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .secret-room__labels {
      fill: #a8a88b;
      font-family: cursive;
      font-size: 20px;
    }

    .secret-room__upper-cat {
      position: absolute;
      top: 12%;
      width: 32%;
      height: auto;
    }

    .secret-room__upper-cat--left {
      left: 10%;
    }

    .secret-room__upper-cat--right {
      right: 10%;
    }

    .secret-room__cats {
      position: absolute;
      top: 68%;
      left: 5%;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2%;
      width: 90%;
    }

    .secret-room__cats img {
      width: 100%;
      height: auto;
    }

    .secret-home__ground {
      display: block;
      min-height: 8rem;
      background: #9bd650;
    }

  }
</style>
