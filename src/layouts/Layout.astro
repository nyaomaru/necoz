---
import "@fontsource/source-sans-3/300.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/500.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import {
  CHAMBER_OF_COMMERCE_ID,
  CONTACT_EMAIL,
  DEFAULT_DESCRIPTION,
  DEFAULT_KEYWORDS,
  DEFAULT_TITLE,
  LEGAL_NAME,
  OGP_IMAGE_HEIGHT,
  OGP_IMAGE_PATH,
  OGP_IMAGE_TYPE,
  OGP_IMAGE_WIDTH,
  SAME_AS_URLS,
  SITE_NAME,
  SITE_URL,
} from "~/lib/site-metadata";
import "~/styles/global.css";
import VirtualScroll from "~/components/ui/scroll/VirtualScroll.astro";

type StructuredData = Record<string, unknown>;

type Props = {
  /** Page description used for the document meta description. */
  description?: string;
  /** Canonical path used to build an absolute canonical URL when the site URL is configured. */
  canonicalPath?: string;
  /** Keywords forwarded to search engines that still use them as a weak signal. */
  keywords?: string;
  /** Whether search engines should index this page. */
  noindex?: boolean;
  /** Open Graph object type. */
  ogType?: "article" | "website";
  /** Additional structured data blocks injected as JSON-LD. */
  structuredData?: StructuredData | StructuredData[];
  /** Page title used for the document title. */
  title?: string;
  /** Whether to use the animated virtual scroll controller. */
  virtualScroll?: boolean;
};

const {
  canonicalPath = Astro.url.pathname,
  description = DEFAULT_DESCRIPTION,
  keywords = DEFAULT_KEYWORDS,
  noindex = false,
  ogType = "website",
  structuredData,
  title = DEFAULT_TITLE,
  virtualScroll = true,
} = Astro.props as Props;

const canonicalUrl = SITE_URL
  ? new URL(canonicalPath, `${SITE_URL}/`).toString()
  : undefined;
const socialPreviewImage = SITE_URL
  ? new URL(OGP_IMAGE_PATH, `${SITE_URL}/`).toString()
  : undefined;

const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  legalName: LEGAL_NAME,
  ...(SITE_URL ? { url: SITE_URL } : {}),
  email: CONTACT_EMAIL,
  identifier: CHAMBER_OF_COMMERCE_ID,
  sameAs: SAME_AS_URLS,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Amsterdam",
    addressCountry: "NL",
  },
};

const websiteStructuredData = SITE_URL
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      url: SITE_URL,
    }
  : null;

const serializeStructuredData = (data: StructuredData) =>
  JSON.stringify(data)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");

const structuredDataBlocks = [
  organizationStructuredData,
  websiteStructuredData,
  ...(Array.isArray(structuredData)
    ? structuredData
    : structuredData
      ? [structuredData]
      : []),
].filter(Boolean) as StructuredData[];
---

<!doctype html>
<html lang="en" class:list={[virtualScroll && "virtual-scroll-root"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={LEGAL_NAME} />
    <meta name="application-name" content={LEGAL_NAME} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialPreviewImage && (
      <meta property="og:image" content={socialPreviewImage} />
    )}
    {socialPreviewImage && (
      <meta property="og:image:type" content={OGP_IMAGE_TYPE} />
    )}
    {socialPreviewImage && (
      <meta property="og:image:width" content={String(OGP_IMAGE_WIDTH)} />
    )}
    {socialPreviewImage && (
      <meta property="og:image:height" content={String(OGP_IMAGE_HEIGHT)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialPreviewImage && (
      <meta name="twitter:image" content={socialPreviewImage} />
    )}
    {
      structuredDataBlocks.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeStructuredData(data)}
        />
      ))
    }
  </head>
  <body
    class:list={[virtualScroll ? "virtual-scroll-body" : "native-scroll-body"]}
  >
    {
      virtualScroll ? (
        <VirtualScroll>
          <slot />
        </VirtualScroll>
      ) : (
        <slot />
      )
    }
    <style is:global>
      body.native-scroll-body {
        min-height: 100vh;
      }
    </style>
  </body>
</html>
