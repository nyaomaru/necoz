---
import SocialLinks from "~/components/ui/layout/SocialLinks.astro";
import MailDialogTrigger from "~/components/ui/mail/mail-dialog-trigger";
import { PORTFOLIO_URL } from "~/lib/site-links";
import { MEDIA_QUERIES } from "~/styles/breakpoints.mjs";

type Props = {
  /** Destination used by the Necoz logo link. */
  homeHref?: string;
};

const { homeHref = "#top" } = Astro.props as Props;
---

<header class="stage-header">
  <picture class="header-clouds" aria-hidden="true">
    <source
      srcset="/assets/backgrounds/smartphone_header.svg"
      media={MEDIA_QUERIES.phone}
    />
    <img src="/assets/backgrounds/header.svg" alt="Necoz header background" />
  </picture>
  <div class="header-overlay">
    <div class="brand">
      <a href={homeHref} aria-label="Necoz home">
        <img src="/assets/necoz_logo.svg" alt="Necoz" />
      </a>
    </div>
    <div class="links">
      <div class="social-menu">
        <MailDialogTrigger client:load />
        <SocialLinks />
      </div>
      <a
        class="portfolio-link"
        href={PORTFOLIO_URL}
        aria-label="Go to portfolio section"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src="/assets/icons/portfolio_gray.png" alt="Portfolio" />
      </a>
    </div>
  </div>
</header>

<style>
  .stage-header {
    position: relative;
    z-index: var(--layer-site-chrome);
    margin: 0 auto;
  }

  .header-clouds {
    display: block;
    width: 100%;
  }

  .header-clouds img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    pointer-events: none;
    margin: 5rem 5rem;
  }

  .header-overlay :global(a),
  .header-overlay :global(button) {
    pointer-events: auto;
  }

  .brand {
    margin: 0;
    line-height: 0;
  }

  .brand img {
    width: 10.5rem;
    height: auto;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: -1.5rem;
  }

  .social-menu {
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    width: 13.5rem;
    aspect-ratio: 1890 / 480;
    padding: 0 0.75rem;
    background: url("/assets/icons/menu_gray.png") center / 100% 100% no-repeat;
  }

  .social-menu :global(.mail-dialog-trigger__icon),
  .social-menu :global(.icon-link img) {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(32%) sepia(3%) saturate(347%)
      hue-rotate(202deg) brightness(97%);
  }

  .social-menu :global(.mail-dialog-trigger__icon) {
    content: url("/assets/icons/smartphone_menu_icon_mail.png");
  }

  .social-menu :global(.social-link--github) {
    content: url("/assets/icons/icon_github_green.png");
  }

  .social-menu :global(.social-link--linkedin) {
    content: url("/assets/icons/icon_linkedin_green.png");
  }

  .social-menu :global(.social-link--x) {
    content: url("/assets/icons/icon_x_green.png");
  }

  .social-menu :global(.mail-dialog-trigger:hover .mail-dialog-trigger__icon),
  .social-menu :global(.mail-dialog-trigger:focus-visible .mail-dialog-trigger__icon),
  .social-menu :global(.icon-link:hover img),
  .social-menu :global(.icon-link:focus-visible img) {
    filter: none;
  }

  .portfolio-link {
    display: inline-flex;
    align-items: center;
    width: 6rem;
  }

  .portfolio-link img {
    width: 100%;
    height: auto;
  }

  :global(.icon-link) {
    display: inline-flex;
    align-items: center;
  }

  .portfolio-link:hover img,
  .portfolio-link:focus-visible img {
    content: url("/assets/icons/portfolio_green.png");
  }

  :global(.icon-link:hover) {
    opacity: 1;
  }

  @media (--necoz-stage-compact) {
    .header-overlay {
      margin: 4rem 4rem;
    }
  }

  @media (--necoz-desktop-compact) {
    .header-overlay {
      margin: 2.5rem 2.5rem;
    }
  }

  @media (max-width: 51.25rem) {
    .header-overlay {
      margin: 1.5rem 1.5rem;
    }

    .brand img {
      width: 6.375rem;
    }

    .social-menu {
      width: 9rem;
    }

    .portfolio-link {
      width: 4rem;
    }

    .social-menu :global(.mail-dialog-trigger__icon),
    .social-menu :global(.icon-link img) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (max-width: 32.5rem) {
    .header-overlay {
      margin: 1.5rem 1.5rem;
    }

    .brand img {
      width: 4.875rem;
    }

    .portfolio-link {
      width: 2.75rem;
    }

    .social-menu {
      width: 6.4rem;
      padding-inline: 0.35rem;
    }

    .links {
      gap: 0.525rem;
    }

    .social-menu :global(.mail-dialog-trigger__icon),
    .social-menu :global(.icon-link img) {
      width: 0.875rem;
      height: 0.875rem;
    }
  }

  @media (--necoz-phone) {
    .header-overlay {
      margin: 1.75rem 1.25rem;
    }

    .links {
      margin-top: -1rem;
    }

    .brand img {
      width: 5rem;
    }

  }
</style>
