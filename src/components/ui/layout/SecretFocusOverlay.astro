---
import { SECRET_PAGE_PATH } from "~/lib/secret-focus/focus-transition";

type Props = {
  /** Exit closes the current page. Enter opens the secret page. */
  mode: "enter" | "exit";
};

const { mode } = Astro.props;
const focusImageSrc = "/assets/focus/nyaomaru-focus.png";
---

<div
  class="secret-focus"
  data-secret-focus-overlay
  data-secret-focus-mode={mode}
  data-secret-focus-path={SECRET_PAGE_PATH}
>
  <div class="secret-focus__shade secret-focus__shade--top"></div>
  <div class="secret-focus__shade secret-focus__shade--bottom"></div>
  <div class="secret-focus__shade secret-focus__shade--left"></div>
  <div class="secret-focus__shade secret-focus__shade--right"></div>
  <img
    class="secret-focus__iris"
    src={focusImageSrc}
    alt=""
    aria-hidden="true"
  />
  <p class="secret-focus__loading" data-secret-focus-loading role="status">
    Loading
  </p>
</div>

<script>
  import { setupSecretFocus } from "~/lib/secret-focus/setup-secret-focus";

  setupSecretFocus();
</script>

<style is:global>
  html[data-secret-focus="loading"] [data-secret-focus-overlay] {
    visibility: visible;
    pointer-events: auto;
    --secret-focus-size: 0px;
  }

  html[data-secret-focus="loading"] [data-secret-focus-loading] {
    display: grid;
  }
</style>

<style>
  .secret-focus {
    --secret-focus-size: 3000px;

    position: fixed;
    inset: 0;
    z-index: var(--layer-secret-focus);
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }

  .secret-focus.is-active {
    visibility: visible;
    pointer-events: auto;
  }

  .secret-focus__shade {
    position: absolute;
    background: #000;
  }

  .secret-focus__shade--top {
    top: 0;
    right: 0;
    left: 0;
    height: max(0px, calc(50% - var(--secret-focus-size) / 2));
  }

  .secret-focus__shade--bottom {
    right: 0;
    bottom: 0;
    left: 0;
    height: max(0px, calc(50% - var(--secret-focus-size) / 2));
  }

  .secret-focus__shade--left {
    top: max(0px, calc(50% - var(--secret-focus-size) / 2));
    bottom: max(0px, calc(50% - var(--secret-focus-size) / 2));
    left: 0;
    width: max(0px, calc(50% - var(--secret-focus-size) / 2));
  }

  .secret-focus__shade--right {
    top: max(0px, calc(50% - var(--secret-focus-size) / 2));
    right: 0;
    bottom: max(0px, calc(50% - var(--secret-focus-size) / 2));
    width: max(0px, calc(50% - var(--secret-focus-size) / 2));
  }

  .secret-focus__iris {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--secret-focus-size);
    height: var(--secret-focus-size);
    transform: translate(-50%, -50%);
  }

  .secret-focus__loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    place-items: center;
    margin: 0;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .secret-focus.is-loading .secret-focus__loading {
    display: grid;
  }
</style>
