---
const designOverlaySrc = "/necoz-mock.png";
---

{
  import.meta.env.DEV && (
    <img
      src={designOverlaySrc}
      class="design-overlay"
      alt=""
      aria-hidden="true"
    />
  )
}

<style>
  .design-overlay {
    display: none;
  }

  @media (--necoz-phone) {
    .design-overlay {
      position: absolute;
      z-index: 999999;
      top: 0;
      left: 0;
      display: block;
      width: 100%;
      height: auto;
      opacity: 0.5;
      pointer-events: none;
    }
  }
</style>
